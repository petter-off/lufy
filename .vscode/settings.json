{
    "search.exclude": {
        "**/.next": true,
        "**/dist": true,
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "pnpm-lock.yaml": true
    },
    "npmx.ignore.vulnerability": [
        "nx",
        "@nx/js",
        "@nx/next",
        "@nx/node",
        "@nx/eslint"
    ],
    "npmx.ignore.deprecation": ["eslint"],
    "cSpell.words": [
        "lufy",
        "nodenext",
        "postcss",
        "smol",
        "tailwindcss",
        "unrs"
    ],
    "references.preferredLocation": "peek"
}
